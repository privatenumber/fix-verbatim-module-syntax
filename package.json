		"clean-pkg-json": "^1.2.0",
		"fs-fixture": "^2.6.0",
		"lintroll": "^1.11.0",
		"manten": "^2.0.0",
		"nano-spawn": "^0.2.0",
		"pkgroll": "^2.6.0",
