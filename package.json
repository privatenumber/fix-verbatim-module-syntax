{
	"name": "fix-verbatim-module-syntax",
	"version": "0.0.0-semantic-release",
	"description": "CLI tool to auto-fix verbatimModuleSyntax errors",
	"keywords": [
		"typescript",
		"tsconfig",
		"fix",
		"verbatimModuleSyntax"
	],
	"license": "MIT",
	"repository": "privatenumber/fix-verbatim-module-syntax",
